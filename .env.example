# ============================================================================
#  Copy this file to ".env" and fill in your real values.
#  The real ".env" must NEVER be committed to git (see .gitignore).
#  Put your REAL secrets in ".env", NOT in this example file.
# ============================================================================

# --- Discord ---------------------------------------------------------------
# The Bot Token from the Discord Developer Portal:
#   Applications -> (your app) -> Bot -> Reset Token / Copy
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# --- OpenRouter ------------------------------------------------------------
# API key from https://openrouter.ai/  (Keys -> Create Key)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Which model(s) to use. You can list SEVERAL, separated by commas.
# The bot tries them left to right: the first is the primary, and the rest
# are fallbacks used only when the previous one is busy (429) or errors.
# Browse/copy exact model IDs from https://openrouter.ai/models (filter "Free").
#
# Default: Gemma 31B (best Thai) -> Gemma 26B -> gpt-oss-20b -> free router.
#
# NOTE: Model IDs change over time. If you get a "model not found" error,
# open the link above and copy the current ID.
OPENROUTER_MODEL=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free,openrouter/free

# --- Bot behaviour (optional — sensible defaults are used if omitted) ------
# Max tokens the model may generate per reply.
MAX_TOKENS=1024

# Creativity/randomness. Lower = more consistent, stable personality; higher =
# more creative but drifts more. 0.5–0.7 recommended for a steady character.
TEMPERATURE=0.6

# How many past messages (shared across all channels) to send as context.
HISTORY_LIMIT=10

# Minimum seconds a single user must wait between requests (spam / cost guard).
USER_COOLDOWN_SECONDS=5

# Path to the SQLite memory file (chat history + facts).
HISTORY_DB=chat_history.db

# Timezone offset from UTC in hours, used to tell the model the real time.
# Thailand = 7 (UTC+7, no daylight saving).
TZ_OFFSET_HOURS=7

# Read the server's member list + roles (for mentioning them). Read-only.
# If set to true, you MUST also enable "SERVER MEMBERS INTENT" in the Discord
# Developer Portal, otherwise the bot will fail to start.
ENABLE_MEMBERS=false

# Your server (guild) ID — makes slash (/) commands appear INSTANTLY in that
# server. Leave empty to register globally (can take up to ~1 hour to show up).
# Get it: Discord Settings -> Advanced -> Developer Mode ON, then right-click
# the server icon -> Copy Server ID.
GUILD_ID=

# Sound file played automatically when the bot joins a voice channel (/join).
# Put an mp3/wav here (relative to the project folder). Requires FFmpeg.
JOIN_SOUND=sounds/join.mp3

# Sound file played by the /kuru command.
KURU_SOUND=sounds/kuru.mp3

# Path to the ffmpeg executable. Leave as "ffmpeg" if it's on your PATH,
# or set the full path e.g. C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg

# System prompt: defines the bot's personality and rules.
# For multiple lines, wrap the whole value in double quotes "...".
SYSTEM_PROMPT=You are a friendly, concise assistant living in a Discord server. Keep replies short and helpful. Answer in the same language the user writes in.
