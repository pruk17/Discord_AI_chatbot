# systemd service to run the Discord bot 24/7 on the Raspberry Pi.
#
# Paths below match this project on the Pi:
#   user = ubt,  dir = /home/ubt/Discord_bot_ws/Discord_AI_chatbot
# (adjust if yours differ). VOICEVOX runs separately as a Docker container
# with --restart unless-stopped, so it comes up on boot on its own.
#
# Install:
#   sudo cp discord-ai-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now discord-ai-bot
# Logs:    journalctl -u discord-ai-bot -f
# Restart: sudo systemctl restart discord-ai-bot   (after a git pull)

[Unit]
Description=Discord AI Chatbot (OpenRouter + VOICEVOX)
# Start after the network is up and Docker (which runs VOICEVOX) has started.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubt
WorkingDirectory=/home/ubt/Discord_bot_ws/Discord_AI_chatbot
# Use the venv's Python directly (no need to "activate").
ExecStart=/home/ubt/Discord_bot_ws/Discord_AI_chatbot/venv/bin/python /home/ubt/Discord_bot_ws/Discord_AI_chatbot/bot.py
# Restart automatically if the bot crashes.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
